{
  "name": "browser-ccg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "airtable": "node ./airtable.node.js",
    "ring": "node ./scripts/apply-ring-url.node.js",
    "board": "node ./scripts/apply-board-url.node.js",
    "deck": "node ./scripts/apply-deck-url.node.js",
    "spell": "node ./scripts/apply-spell-url.node.js",
    "fxsprite": "node ./scripts/add-fx-sprite.node.js",
    "asset": "ts-node --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2019\",\"esModuleInterop\":true}' ./scripts/art/asset.node.ts",
    "art": "ts-node --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2019\",\"esModuleInterop\":true}' ./scripts/art/art.node.ts",
    "upscale": "ts-node --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2019\",\"esModuleInterop\":true}' ./scripts/art/upscale.node.ts",
    "sim:heroes": "ts-node --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2019\"}' ./engine/sim/hero-sim.node.ts",
    "tune": "ts-node --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2019\"}' ./engine/sim/tune.node.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,scss}\"",
    "test": "export TS_JEST_DISABLE_VER_CHECKER=true && jest --config ./jest.config.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:dev": "SERVE_NEXT=false ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"target\":\"es2020\",\"esModuleInterop\":true,\"resolveJsonModule\":true}' ./server/index.ts",
    "start:prod": "NODE_ENV=production node dist-server/server/index.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.6",
    "@use-gesture/react": "^10.2.20",
    "@visx/visx": "^2.16.0",
    "bgio-effects": "^0.7.1",
    "boardgame.io": "^0.49.12",
    "canvas-confetti": "^1.9.4",
    "chalk": "^4.1.2",
    "dotenv": "^16.0.3",
    "immer": "^9.0.7",
    "lodash": "^4.17.21",
    "magic.css": "^1.4.8",
    "marked": "^4.3.0",
    "mathjs": "^11.2.1",
    "next": "^12.3.2",
    "next-svgr": "^0.0.2",
    "pixi.js": "^7.4.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.6.0",
    "react-redux": "^8.0.4",
    "react-scripts": "5.0.1",
    "react-select": "^5.6.1",
    "react-spring": "^9.5.5",
    "typescript": "^4.8.4",
    "use-callback-ref": "^1.3.0",
    "use-long-press": "^2.0.2",
    "uuid": "^9.0.0",
    "web-vitals": "^2.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.62",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/semver": "^7.3.13",
    "@types/uuid": "^8.3.4",
    "@types/webpack-env": "^1.18.0",
    "@types/ws": "^8.5.1",
    "jest-matcher-one-of": "^1.0.2",
    "node-sass": "^7.0.3",
    "prettier": "^3.10.1",
    "sass": "^1.55.0",
    "sharp": "^0.35.5",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1"
  }
}
